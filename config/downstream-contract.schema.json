{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gear.example.test/schemas/downstream-contract.schema.json",
  "title": "Gear Share private downstream contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "publicRelease", "privateOverlay", "temporaryHotfixes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "publicRelease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "commit"],
      "properties": {
        "tag": { "type": "string", "pattern": "^gear-share-v[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "privateOverlay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths", "valueClasses"],
      "properties": {
        "paths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["config/private/**", "public/brand/private/**", "docs/operations/**", "docs/evidence/**"] }
        },
        "valueClasses": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "community-presentation",
              "authorized-artwork",
              "public-origin-and-routing",
              "runtime-provider-reference",
              "private-operations-and-evidence",
              "consumed-public-release"
            ]
          }
        }
      }
    },
    "temporaryHotfixes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "paths", "rationale", "privateCommit", "tests", "ownerRole", "reviewBy", "publicPort"],
        "properties": {
          "id": { "type": "string", "pattern": "^HOTFIX-[0-9]{4}$" },
          "status": { "enum": ["temporary", "reconciled"] },
          "paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "rationale": { "type": "string", "minLength": 1 },
          "privateCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "tests": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "ownerRole": { "type": "string", "minLength": 1 },
          "reviewBy": { "type": "string", "format": "date" },
          "publicPort": { "type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+/(?:issues|pull)/[0-9]+$" },
          "reconciledPublicTag": { "type": "string", "pattern": "^gear-share-v[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "reconciledPublicCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
        }
      }
    }
  }
}
